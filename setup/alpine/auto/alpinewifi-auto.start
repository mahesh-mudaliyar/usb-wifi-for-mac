#!/bin/sh
# Runs by itself when the installer's Alpine CD boots (it is inside the CD's apkovl).
# Phase 1: installs Alpine onto the virtual disk with no questions, copies the Wi-Fi setup onto it
# so it runs on the first boot from disk, then powers off. The Mac watches /root/alpinewifi-auto.log.
LOG=/root/alpinewifi-auto.log
S=/etc/alpinewifi
DISK=/dev/nvme0n1

say()  { echo "$*"; echo "$(date '+%F %T') $*" >> "$LOG"; }
fail() { say "PHASE1 FAILED: $* boot=$(cat /proc/sys/kernel/random/boot_id)"; say "The machine stays on so you can look. Log: $LOG"; exit 1; }

# only on the installer CD (Alpine running from memory), only once. setup-alpine copies /etc onto
# the disk, so without these checks this would run again on every boot from the disk.
[ "$(awk '$2 == "/" {print $3}' /proc/mounts)" = tmpfs ] || exit 0
[ -f "$S/answers" ] || exit 0
[ -f /tmp/alpinewifi-auto.ran ] && exit 0
touch /tmp/alpinewifi-auto.ran

say "=== Mac Wi-Fi: installing Alpine to the disk (no questions asked) ==="
i=0
until [ -b "$DISK" ]; do i=$((i + 1)); [ $i -ge 20 ] && fail "no virtual disk at $DISK"; sleep 1; done

say "1/3 Running setup-alpine (network, clock, packages, SSH, disk) - about 2-6 min..."
ERASE_DISKS=$DISK timeout 1200 setup-alpine -e -f "$S/answers" < /dev/null >> "$LOG" 2>&1
rc=$?
[ $rc -eq 0 ] || fail "setup-alpine stopped with code $rc (124 = took longer than 20 minutes)"

say "2/3 Copying the Wi-Fi setup onto the new disk..."
ROOT=""
for p in "${DISK}p3" "${DISK}p2" "${DISK}p1"; do
  blkid "$p" 2>/dev/null | grep -q 'TYPE="ext4"' && { ROOT=$p; break; }
done
[ -n "$ROOT" ] || fail "can't find the installed system on $DISK"
mkdir -p /mnt/alp
mount "$ROOT" /mnt/alp || fail "can't open the installed system ($ROOT)"
mkdir -p /mnt/alp/root/alpinewifi-setup /mnt/alp/etc/local.d /mnt/alp/etc/runlevels/default /mnt/alp/root/.ssh
cp -a "$S/setup/." /mnt/alp/root/alpinewifi-setup/ || { umount /mnt/alp; fail "copying the setup files failed"; }
cp "$S/alpinewifi-firstboot.start" /mnt/alp/etc/local.d/ && chmod 755 /mnt/alp/etc/local.d/alpinewifi-firstboot.start
ln -sf /etc/init.d/local /mnt/alp/etc/runlevels/default/local
# the installed system must not run the CD installer again
rm -rf /mnt/alp/etc/local.d/alpinewifi-auto.start /mnt/alp/etc/alpinewifi /mnt/alp/etc/.default_boot_services
grep -qF "$(cut -d' ' -f2 "$S/key.pub")" /mnt/alp/root/.ssh/authorized_keys 2>/dev/null || cat "$S/key.pub" >> /mnt/alp/root/.ssh/authorized_keys
chmod 700 /mnt/alp/root/.ssh; chmod 600 /mnt/alp/root/.ssh/authorized_keys
cp "$LOG" /mnt/alp/root/alpinewifi-phase1.log 2>/dev/null
sync
umount /mnt/alp || fail "couldn't close the installed system"

say "3/3 Installed to $DISK."
say "PHASE1 DONE boot=$(cat /proc/sys/kernel/random/boot_id)"
say "Shutting down in 10 seconds."
sleep 10
poweroff
