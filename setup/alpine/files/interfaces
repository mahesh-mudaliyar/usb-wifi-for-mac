auto lo
iface lo inet loopback

auto eth0
iface eth0 inet static
	address __ALPINE_IP__
	netmask 255.255.255.0

auto wlan0
iface wlan0 inet dhcp
	pre-up for i in $(seq 1 20); do [ -e /sys/class/net/wlan0 ] && break; sleep 1; done; wpa_supplicant -B -s -i wlan0 -c /etc/wpa_supplicant/wpa_supplicant.conf
	post-down killall wpa_supplicant 2>/dev/null || true
